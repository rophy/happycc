{
  "name": "@happycc/agent",
  "version": "0.1.0",
  "description": "Command-line client for happycc sessions, for scripts and automation",
  "author": "Kirill Dubovitskiy",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/rophy/happycc",
  "bugs": "https://github.com/rophy/happycc/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/rophy/happycc"
  },
  "bin": {
    "happycc-agent": "./bin/happy-agent.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --noEmit && pkgroll",
    "test": "$npm_execpath run build && vitest run",
    "test:integration": "$npm_execpath run build && vitest run --config vitest.integration.config.ts",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "$npm_execpath run build && $npm_execpath test",
    "release": "npx --no-install release-it"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "open": "^10.2.0",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@slopus/happy-wire": "workspace:*",
    "@types/node": ">=20",
    "pkgroll": "^2.14.2",
    "release-it": "^19.0.6",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@10.11.0"
}
