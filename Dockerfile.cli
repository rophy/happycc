# happycc CLI on a simulated client device: the CLI packed from this repo and
# installed globally like a release, plus the coding agents it drives (Claude
# Code, OpenCode, and Pi through the pi-acp adapter) and git. Node 22: Pi needs it.
# Used by the `cli` service in docker-compose.yaml.

FROM node:20 AS deps

RUN apt-get update && apt-get install -y python3 make g++ build-essential && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate

WORKDIR /repo

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY scripts ./scripts
COPY patches ./patches

RUN mkdir -p packages/happy-cli packages/happy-wire packages/happy-agent

COPY packages/happy-cli/package.json packages/happy-cli/
COPY packages/happy-wire/package.json packages/happy-wire/
COPY packages/happy-agent/package.json packages/happy-agent/

# Workspace postinstall requirements
COPY packages/happy-cli/scripts packages/happy-cli/scripts
COPY packages/happy-cli/tools packages/happy-cli/tools

RUN SKIP_HAPPY_WIRE_BUILD=1 pnpm install --frozen-lockfile --filter happycc... --filter happycc-agent...

FROM deps AS builder

COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-cli ./packages/happy-cli
COPY packages/happy-agent ./packages/happy-agent

RUN pnpm --filter @slopus/happy-wire --fail-if-no-match build
RUN pnpm --filter happycc --fail-if-no-match build
# Pack it like a release, so the device installs it the way users do.
RUN mkdir /pack && pnpm --filter happycc --fail-if-no-match pack --pack-destination /pack \
    && mv /pack/happycc-*.tgz /pack/happycc.tgz
RUN pnpm --filter happycc-agent --fail-if-no-match build
RUN pnpm --filter happycc-agent --fail-if-no-match pack --pack-destination /pack \
    && mv /pack/happycc-agent-*.tgz /pack/happycc-agent.tgz

FROM node:22 AS runner

# Standalone claude for local mode. Keep it equal to the Claude Code version bundled with the exact
# @anthropic-ai/claude-agent-sdk pin in packages/happy-cli/package.json (see: npm view @anthropic-ai/claude-agent-sdk@<version> claudeCodeVersion),
# which is what remote mode runs.
ARG CLAUDE_CODE_VERSION=2.1.288
ARG OPENCODE_VERSION=1.18.34
ARG PI_VERSION=1.0.0
ARG PI_ACP_VERSION=0.0.34

RUN apt-get update && apt-get install -y git ripgrep && rm -rf /var/lib/apt/lists/*
RUN npm install -g --no-audit --no-fund \
        @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
        opencode-ai@${OPENCODE_VERSION} \
        @earendil-works/pi-coding-agent@${PI_VERSION} \
        pi-acp@${PI_ACP_VERSION} \
    && npm cache clean --force

RUN --mount=type=bind,from=builder,source=/pack,target=/pack \
    npm install -g /pack/happycc.tgz /pack/happycc-agent.tgz --no-audit --no-fund && npm cache clean --force

RUN mkdir -p /workspace /home/node/.happycc /home/node/.claude /home/node/.config/opencode /home/node/.pi/agent \
    && chown -R node:node /workspace /home/node

USER node
WORKDIR /workspace

# Keep the device up; use `docker compose exec cli happycc ...` to drive it.
CMD ["sleep", "infinity"]
